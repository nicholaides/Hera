try
  { register } := require('node:module')
  { pathToFileURL } := require('node:url')

  register './esm.cjs', pathToFileURL(__filename)
catch
  // older Node lacking module register

if require.extensions
  try
    require("@cspotcode/source-map-support/register-hook-require")

  fs := require("fs")
  { compile } := require("./main.js")

  require.extensions[".hera"] = (module, filename) =>
    js := compile(fs.readFileSync(filename, 'utf8'), {
      filename,
      inlineMap: true,
    })

    return module._compile(js, filename)
