{ resolve, buildLoadFunction } from "./esm.civet";
{ compileTsToJs } from "./tsc-helper.civet";

let registerOptions;

function initialize(data = {}) {
  registerOptions = data;
}

load := buildLoadFunction({
  getOptions: => registerOptions
  postProcess: (source: string) => compileTsToJs(source, { compilerOptions: registerOptions.tsc })
})

export { initialize, resolve, load };
