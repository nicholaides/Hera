{ readFile } from node:fs/promises
{ relative } from node:path
{ compile } from ./main.civet
{ type CompilerOptions } from "./compiler.civet"
{ type Plugin } from esbuild

interface HeraPluginOptions < CompilerOptions
  loader?: string

export default function heraEsbuildPlugin({ loader, ...heraOptions }: HeraPluginOptions = {}): Plugin
  name: 'hera'
  setup: (build) =>
    build.onLoad { filter: /.\.hera$/ }, ({ path }) =>
      filename := relative(process.cwd(), path)

      try
        readFile(path, 'utf8')
          |> await
          |> compile ., { ...heraOptions, filename }
          |> { contents: & }
          |> (load) => loader ? { ...load, loader } : load

      catch e
        text := String(e && e <? 'object' && 'message' in e ? e.message : e)
        errors: [{ text }]
