{ fileURLToPath, pathToFileURL } from node:url
fs from node:fs
{ compile } from ./main.civet
import type { CompilerOptions } from ./compiler.civet


export interface LoadHook
  (url: string, context: Context, next: LoadHookNext): Promise<LoadHookResult> | LoadHookResult

interface LoadHookResult
  source: string
  format: string
  shortCircuit: boolean

interface LoadHookNext
  (url: string, context: Context): Promise<LoadHookResult> | LoadHookResult

interface Context
  parentURL?: string


baseURL := pathToFileURL(process.cwd() + "/").href
extensionsRegex := /\.hera$/


// module-level state that is set via the initialize function
let heraOptions: CompilerOptions
export function initialize(data: CompilerOptions = {})
  heraOptions = data


export function resolve(specifier: string, context: Context, next: (specifier: string, context: Context) => ???)
  return next(specifier, context) unless extensionsRegex.test(specifier)

  { parentURL = baseURL } := context

  {
    url: new URL(specifier, parentURL).href
    shortCircuit: true
  }


export function load(url: string, context: Context, next: LoadHookNext)
  return next(url, context) unless extensionsRegex.test(url)

  filename := fileURLToPath(url)
  source :=
    filename
      |> fs.readFileSync(., "utf8")
      |> compile(., { filename, inlineMap: true, ...heraOptions })

  {
    source,
    format: "commonjs", // options.hera.module ? "module" : "commonjs"
    // TODO: how to avoid shortCircuit?
    // We may want to pass the module to babel or whatever in the future
    shortCircuit: true
  }


export function transformLoadHook(
  matchUrl: (url: string) => boolean
  fn: (source: string, context: Context, result: LoadHookResult) => string | Promise<string>
): LoadHook
  async (url, context, next) =>
    result := await next(url, context)

    if matchUrl(url)
      { ...result, source: await fn(result.source, context, result) }
    else
      result
