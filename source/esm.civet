{ fileURLToPath, pathToFileURL } from node:url

{ transformFile, type HeraRegisterOptions } from ./register/transform.civet
import type { CompilerOptions } from ./compiler.civet


export interface LoadHookResult
  source: string
  format: string
  shortCircuit: boolean

export interface LoadHook
  (url: string, context: Context, next: LoadHookNext): LoadHookResult

export interface LoadHookNext
  (url: string, context: Context): LoadHookResult


export interface Context
  parentURL?: string

export interface HeraLoaderOptions
  hera?: CompilerOptions

export PostProcessFn ::= (source: string, options: HeraLoaderOptions, loadContext: { url: string, context: Context }) => string


baseURL := pathToFileURL(process.cwd() + "/").href
extensionsRegex := /\.hera$/


export function resolve(specifier: string, context: Context, defaultResolve: (specifier: string, context: Context) => ???)
  { parentURL = baseURL } := context

  return defaultResolve(specifier, context) unless extensionsRegex.test(specifier)

  {
    url: new URL(specifier, parentURL).href
    shortCircuit: true
  }

export function loadHera(
  url: string
  context: Context
  next: LoadHookNext
  options: HeraRegisterOptions
)
  return next(url, context) unless extensionsRegex.test(url)

  filename := fileURLToPath(url)

  {
    ...transformFile(filename, options)
    // TODO: how to avoid shortCircuit?
    // We may want to pass the module to babel or whatever in the future
    shortCircuit: true
  }

export load: LoadHook := buildLoadFunction({})

export function buildLoadFunction(heraLoaderOptions: HeraRegisterOptions): LoadHook
  (url, context, next) =>
    loadHera(url, context, next, heraLoaderOptions)
