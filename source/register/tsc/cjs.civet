{ type CompilerOptions, transpileTsToJs } from ./transpile.civet

// Register this module as a CJS loader
export function pushTranspileStepToCjsLoader(compilerOptions: CompilerOptions = {})
  if heraChain: any := require.extensions?['.hera'] // only run if require.extensions exists
    // add a transform step to the Hera CJS loader
    heraChain.pushTransformSource (source: string) => transpileTsToJs(source, compilerOptions)
