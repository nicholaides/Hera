{ register } from node:module
{ pathToFileURL } from node:url
typescript from typescript

type { HeraTscRegisterOptions } from ./hooks.civet

import { registerHooksAsCjs } from ../cjs.civet

* as hooks from ./hooks.civet

function registerLoader({
  tsc = {}
  hera = {}
}: HeraTscRegisterOptions = {})

  // make copies so we can modify them
  tsc = { ...tsc }
  hera = { ...hera }

  tsc.target ??= typescript.ScriptTarget.ES2022 // based on @tsconfig/node-lts
  tsc.module ??= typescript.ModuleKind.CommonJS // use CommonJS by default because it works with CJS and ESM contexts

  // set the module flag for hera.compile
  hera.module ??= tsc.module !== typescript.ModuleKind.CommonJS

  register "./hooks.js", pathToFileURL(__filename), data: { tsc, hera }
  registerHooksAsCjs hooks, data: { tsc, hera }

export {
  typescript
  registerLoader
}
