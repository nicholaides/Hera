{ resolve, buildLoadFunction } from ../../esm.civet
{ type HeraLoaderOptions } from ../../esm.civet

{ compileTsToJs, type CompilerOptions } from ./helper.civet

export interface HeraTscRegisterOptions < HeraLoaderOptions
  tsc?: CompilerOptions


let registerOptions: HeraTscRegisterOptions

function initialize(data: HeraTscRegisterOptions = {})
  registerOptions = data

load := buildLoadFunction
  getOptions: => registerOptions
  postProcess: compileTsToJs(., compilerOptions: registerOptions.tsc)

export { initialize, resolve, load }
