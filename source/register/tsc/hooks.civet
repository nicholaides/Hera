{ resolve, buildLoadFunction, type LoadHook } from ../../esm.civet
{ type HeraLoaderOptions } from ../transform.civet

{ transpileTsToJs, type CompilerOptions } from ./transpile.civet

export interface HeraTscRegisterOptions < HeraLoaderOptions
  tsc?: CompilerOptions


let registerOptions: HeraTscRegisterOptions

function initialize(data: HeraTscRegisterOptions = {})
  registerOptions = data

load: LoadHook := buildLoadFunction
  getOptions: => registerOptions
  postProcess: transpileTsToJs(., compilerOptions: registerOptions.tsc)

export { initialize, resolve, load }
