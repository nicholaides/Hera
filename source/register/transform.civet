fs from node:fs

{ compile } from ../main.civet
import type { CompilerOptions } from ../compiler.civet


export interface Context
  parentURL?: string

export interface HeraLoaderOptions
  hera?: CompilerOptions

export interface HeraRegisterOptions
  getOptions?: => HeraLoaderOptions
  postProcess?: PostProcessFn

export PostProcessFn ::= (source: string, options: HeraLoaderOptions, context: { filename: string }) => string


export function transformFile(
  filename: string
  {
    getOptions = => {}
    postProcess = &
  }: HeraRegisterOptions = {}
)
  options := getOptions() ?? {}
  options.hera ??= {}
  options.hera.module ??= false

  source := compile(fs.readFileSync(filename, "utf8"), {
    filename,
    inlineMap: true,
    ...options.hera,
  })

  processedSource := postProcess(source, options, { filename })

  {
    source: processedSource
    format: options.hera.module ? "module" : "commonjs"
  }
