assert from node:assert

type { Module } from node:module
type { CompilerOptions as HeraCompilerOptions } from ../compiler.civet

type Middleware = (payload: Payload, next: (payload: Payload) => Payload) => Payload

interface Payload
  source?: string
  filename?: string

function runMiddlewares([...stack, current]: Middleware[], payload: Payload): Payload
  if !current then throw new Error("Ran out of middlewares to run")
  current(payload, (nextContext: Payload) => runMiddlewares(stack, nextContext))

export middlewares: Middleware[] := []

export options := {
  hera: {} as HeraCompilerOptions
}

export function pushTransformSource(transform: (source: string, payload: Payload) => string)
  middlewares.push (payload, next) =>
    result := next(payload)
    assert result.source
    { ...result, source: transform(result.source, result) }

export pushMiddleware := middlewares@push


if require.extensions
  try
    require "@cspotcode/source-map-support/register-hook-require"

  require.extensions[".hera"] = (module: Module, filename: string) =>
    runMiddlewares(middlewares, { filename })
      |> .source
      ||> assert(., `file ${filename} was loaded without providing source code`)
      |> (module as any)._compile(., filename)

  { readFileSync } := require("fs")
  pushMiddleware (payload) =>
    { ...payload, source: readFileSync(payload.filename, "utf8") }

  { compile: heraCompile } := require("../main.civet")
  pushTransformSource (source, { filename }) =>
    heraCompile(source, { filename, inlineMap: true, ...options.hera })
