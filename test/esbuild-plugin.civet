assert from assert
{ writeFileSync, mkdirSync, rmSync } from node:fs
path from node:path
esbuild from esbuild
esbuildPlugin from ../source/esbuild.civet

tmpDir := path.join 'tmp', 'esbuild-plugin-testing'

function buildWithPlugin(basename: string, pluginOptions: any, tsSource: string)
  tsFile := path.join tmpDir, `${basename}.ts`
  jsFile := path.join tmpDir, `${basename}.js`

  writeFileSync tsFile, tsSource

  await esbuild.build
    entryPoints: [tsFile]
    outfile: jsFile
    bundle: true
    format: 'cjs'
    plugins: [
      esbuildPlugin(pluginOptions)
    ]

  import(`../${jsFile}`)


describe "esbuild plugin", ->
  @beforeAll -> mkdirSync tmpDir, recursive: true
  @afterAll -> rmSync tmpDir, recursive: true

  it "should transform untyped grammars", ->
    { parse } := await buildWithPlugin 'math-example', {}, """
      import { parse } from '../../samples/math.hera' // relative to the generated parser file
      export { parse }
    """

    assert.equal parse('8 + 3 / 7'), 8 + 3 / 7


  it "should transform typed grammars by allowing the loader to be specified", ->
    writeFileSync 'tmp/typed-grammar.hera', """
      Rule
        "a" ->
          return "ok" as string
    """

    { parse } := await buildWithPlugin 'typed-grammar', { loader: 'ts' },
    """
      import { parse } from '../typed-grammar.hera' // relative to the generated parser file
      export { parse }
    """

    assert.equal parse('a'), "ok"
