assert from assert
{ compileTsToJs, typescript } from ../source/tsc-helper.civet

describe "tsc-helper", ->
  describe "compileTsToJs", ->
    function removeSourceMap(sourceCode: string)
      sourceCode.split('//#')[0].trim()

    it "should compile TypeScript code to JavaScript", ->
      ts := "const a = (a: number, b: number) => a + b"
      js := compileTsToJs(ts) |> removeSourceMap

      assert.equal js, "var a = function (a, b) { return a + b; };"

    it "should accept compiler options", ->
      ts := "const a = (a: number, b: number) => a + b"
      js := compileTsToJs(ts, compilerOptions: { target: typescript.ScriptTarget.ES2022 }) |> removeSourceMap

      assert.equal js, "const a = (a, b) => a + b;"

    it "should not complain about type errors types", ->
      ts := "const a: number = null"
      js := compileTsToJs(ts) |> removeSourceMap

      assert.equal js, "var a = null;"

    it "should complain about syntax errors", ->
      ts := "!!!"

      logged .= ''

      assert.throws
        => compileTsToJs(ts, log: (message: string) => logged = message)
        Error
      assert.match logged, /Expression expected/
