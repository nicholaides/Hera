#!/usr/bin/env bash

shopt -s globstar
set -euox pipefail

cd register-examples/

# For JS grammars
node -r @danielx/hera/register ./use-untyped-grammar.mjs
node -r @danielx/hera/register ./use-untyped-grammar.cjs

# For TS grammars
node -r @danielx/hera/register/tsc ./use-typed-grammar.mjs
node -r @danielx/hera/register/tsc ./use-typed-grammar.cjs

# For JS grammars with custom Hera options
node -r ./custom-hera/register.js ./custom-hera/use.mjs
node -r ./custom-hera/register.js ./custom-hera/use.cjs

# For TS grammars with custom compiler options
node -r ./custom-tsc/register.js ./custom-tsc/use.mjs
node -r ./custom-tsc/register.js ./custom-tsc/use.cjs

# For custom transforms after Hera compile
node -r ./custom-transform/register.js ./custom-transform/use.mjs
node -r ./custom-transform/register.js ./custom-transform/use.cjs

