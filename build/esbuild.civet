esbuild from esbuild
civetPlugin from @danielx/civet/esbuild
//@ts-expect-error
heraPlugin from ../node_modules/@danielx/hera/esbuild-plugin.js

watch := process.argv.includes '--watch'
minify := process.argv.includes '--minify'
sourcemap := false

// In order to compile a .hera file that contains typescrypt code, the
// heraPlugin's onLoad needs to return with loader: 'ts'
// Since we can't build Hera with the heraPlugin in our source code, we'll wrap
// output of the previous release's plugin until Hera has another release then we can use that.
heraPluginThatReturnsTs := (...options) =>
  orig := heraPlugin(...options)
  {
    ...orig
    setup: (build) =>
      orig.setup
        onLoad: (attrs, cb) =>
          build.onLoad attrs, (...args) =>
            cb(...args).then { ...&, loader: 'ts'}
  }

esbuild.build({
  entryPoints: ['source/main.civet']
  tsconfig: "./tsconfig.json"
  bundle: true
  keepNames: true
  external: ["fs"]
  format: "cjs"
  sourcemap
  minify
  watch
  platform: 'node'
  outdir: 'dist/'
  plugins: [
    heraPluginThatReturnsTs
      inlineMap: true
      module: true
    civetPlugin
      ts: "civet"
      emitDeclaration: true
  ]
}).catch -> process.exit 1

esbuild.build({
  entryPoints: ['source/cli.civet']
  tsconfig: "./tsconfig.json"
  bundle: false
  format: "cjs"
  sourcemap
  minify
  watch
  platform: 'node'
  outfile: 'dist/hera'
  plugins: [
    civetPlugin
      ts: "civet"
  ]
}).catch -> process.exit 1

esbuild.build
  entryPoints: ["source/esbuild-plugin.civet"]
  tsconfig: "./tsconfig.json"
  format: "cjs"
  bundle: false
  platform: 'node'
  outfile: 'dist/esbuild.js'
  plugins: [
    civetPlugin
      ts: "civet"
  ]

esbuild.build
  entryPoints: [
    "source/esm.civet"
    "source/register.civet"
    "source/register/tsc.civet"
    "source/register/tsc/transpile.civet"
    "source/register/tsc/hooks.civet"
    "source/register/tsc/loader.civet"
  ]
  tsconfig: "./tsconfig.json"
  format: "cjs"
  bundle: false
  platform: 'node'
  outdir: 'dist/'
  outbase: 'source/'
  plugins: [
    civetPlugin
      ts: "civet"
      emitDeclaration: true
  ]
