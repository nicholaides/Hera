esbuild from esbuild
civetPlugin from @danielx/civet/esbuild
// heraPlugin from ../node_modules/@danielx/hera/esbuild-plugin.js

//------
// The esbuild plugin from the previous release doesn't work with grammars that generate TypeScript so until the next release, we'll just use this version of the plugin:
// @ts-expect-error
{ compile } from ../node_modules/@danielx/hera/dist/main.js
{ type Plugin } from esbuild
{ readFile } from node:fs/promises
{ relative } from node:path

function heraPlugin(heraOptions: any = {}): Plugin
  name: 'hera'
  setup: (build) =>
    build.onLoad { filter: /.\.hera$/ }, ({ path }) =>
      filename := relative(process.cwd(), path)

      try
        readFile(path, 'utf8')
          |> await
          |> compile ., { ...heraOptions, filename }
          |> { contents: &, loader: 'ts' }

      catch e
        text := String(e && e <? 'object' && 'message' in e ? e.message : e)
        errors: [{ text }]
//------



watch := process.argv.includes '--watch'
minify := process.argv.includes '--minify'
sourcemap := false


esbuild.build({
  entryPoints: ['source/main.civet']
  tsconfig: "./tsconfig.json"
  bundle: true
  keepNames: true
  external: ["fs"]
  format: "cjs"
  sourcemap
  minify
  watch
  platform: 'node'
  outdir: 'dist/'
  plugins: [
    heraPlugin
      inlineMap: true
      module: true
    civetPlugin
      ts: "civet"
      emitDeclaration: true
  ]
}).catch -> process.exit 1

esbuild.build({
  entryPoints: ['source/cli.civet']
  tsconfig: "./tsconfig.json"
  bundle: false
  format: "cjs"
  sourcemap
  minify
  watch
  platform: 'node'
  outfile: 'dist/hera'
  plugins: [
    civetPlugin
      ts: "civet"
  ]
}).catch -> process.exit 1


esbuild.build
  entryPoints: [
    "source/esbuild.civet"
    "source/esm.civet"
    "source/hera-types.civet"
    "source/register.civet"
    "source/register/cjs.civet"
    "source/register/transform.civet"
    "source/register/tsc.civet"
    "source/register/tsc/hooks.civet"
    "source/register/tsc/loader.civet"
    "source/register/tsc/transpile.civet"
  ]
  tsconfig: "./tsconfig.json"
  format: "cjs"
  bundle: false
  platform: 'node'
  outdir: 'dist/'
  outbase: 'source/'
  plugins: [
    civetPlugin
      ts: "civet"
      emitDeclaration: true
  ]
